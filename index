<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Francisco José & Celia | Nuestra boda</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap');
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#f7f3ed;color:#3f3934;font-family:Montserrat,sans-serif;font-weight:300}
.hero{min-height:100vh;display:flex;align-items:flex-end;justify-content:center;text-align:center;padding:50px 22px;background:linear-gradient(180deg,transparent 30%,rgba(35,30,25,.78)),url('foto-francisco-jose-y-celia.jpg') center/cover}
.hero-content{color:white;max-width:720px;padding-bottom:28px}
.small{letter-spacing:5px;text-transform:uppercase;font-size:11px}
.names{font:500 clamp(48px,10vw,88px)/.9 'Cormorant Garamond',serif;margin:20px 0 14px}
.date{font:400 22px 'Cormorant Garamond',serif;letter-spacing:4px}
section{max-width:900px;margin:auto;padding:78px 25px;text-align:center}
.intro{font:400 42px/1.1 'Cormorant Garamond',serif}
.quote{font:italic 22px/1.5 'Cormorant Garamond',serif;margin:25px auto;max-width:650px}
.orn{letter-spacing:8px;margin:25px}
.countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:650px;margin:40px auto 0}
.count{background:#fff;border:1px solid #e5ddd3;padding:22px 8px}
.count strong{display:block;font:500 38px 'Cormorant Garamond',serif}
.count span{font-size:9px;letter-spacing:2px;text-transform:uppercase}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:40px}
.card{background:#fff;padding:38px 20px;border:1px solid #e5ddd3}
.card h2{font:500 34px 'Cormorant Garamond',serif;margin:10px}
.card p{line-height:1.8}
.time{font-size:11px;letter-spacing:3px;text-transform:uppercase}
.button{display:inline-block;margin-top:12px;padding:12px 22px;border:1px solid #8c8175;color:#3f3934;text-decoration:none;font-size:10px;letter-spacing:2px;text-transform:uppercase}
.rsvp{background:#eee7de}
footer{padding:55px 20px;text-align:center;background:#e8dfd5}
.footer-names{font:500 38px 'Cormorant Garamond',serif}
@media(max-width:650px){.cards{grid-template-columns:1fr}.countdown{grid-template-columns:repeat(2,1fr)}.intro{font-size:36px}}
</style>
</head>
<body>

<header class="hero">
  <div class="hero-content">
    <div class="small">Nos casamos</div>
    <div class="names">Francisco José & Celia</div>
    <div class="date">01 · 05 · 2027</div>
  </div>
</header>

<section>
  <div class="orn">✦</div>
  <div class="intro">Dos caminos que se encuentran, una historia que comienza para siempre.</div>
  <p class="quote">Queremos compartir con vosotros uno de los días más importantes de nuestras vidas.</p>
</section>

<section>
  <div class="small">Falta muy poquito</div>
  <div class="countdown" id="countdown">
    <div class="count"><strong id="days">—</strong><span>Días</span></div>
    <div class="count"><strong id="hours">—</strong><span>Horas</span></div>
    <div class="count"><strong id="minutes">—</strong><span>Minutos</span></div>
    <div class="count"><strong id="seconds">—</strong><span>Segundos</span></div>
  </div>
</section>

<section>
  <div class="small">El gran día</div>
  <div class="cards">
    <div class="card">
      <div class="time">12:30</div>
      <h2>Ceremonia</h2>
      <p>Iglesia de San Bartolomé</p>
      <a class="button" href="https://www.google.com/maps/search/?api=1&query=Iglesia+de+San+Bartolom%C3%A9" target="_blank">Cómo llegar</a>
    </div>
    <div class="card">
      <div class="time">Después de la ceremonia</div>
      <h2>Celebración</h2>
      <p>Finca Aguasanta</p>
      <a class="button" href="https://www.google.com/maps/search/?api=1&query=Finca+Aguasanta" target="_blank">Cómo llegar</a>
    </div>
  </div>
</section>

<section class="rsvp">
  <div class="small">Confirmación</div>
  <div class="intro">Nos encantará contar contigo</div>
  <p class="quote">Muy pronto podrás confirmar tu asistencia desde aquí.</p>
</section>

<footer>
  <div class="footer-names">Francisco José & Celia</div>
  <p>01 · 05 · 2027</p>
  <div class="orn">♡</div>
</footer>

<script>
const weddingDate = new Date('2027-05-01T12:30:00');
function updateCountdown(){
  const now = new Date();
  let diff = weddingDate - now;
  if(diff < 0) diff = 0;
  const days = Math.floor(diff / 86400000);
  const hours = Math.floor((diff % 86400000) / 3600000);
  const minutes = Math.floor((diff % 3600000) / 60000);
  const seconds = Math.floor((diff % 60000) / 1000);
  document.getElementById('days').textContent = days;
  document.getElementById('hours').textContent = String(hours).padStart(2,'0');
  document.getElementById('minutes').textContent = String(minutes).padStart(2,'0');
  document.getElementById('seconds').textContent = String(seconds).padStart(2,'0');
}
updateCountdown();
setInterval(updateCountdown,1000);
</script>
</body>
</html>
